# EditorConfig — see https://editorconfig.org
# Keeps whitespace, encoding and line endings consistent across editors and OSes.

root = true

# Defaults for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python — PEP 8 (4 spaces, already default)
[*.py]
indent_size = 4
max_line_length = 100

# Shell scripts — LF mandatory (cron + systemd will not accept CRLF)
[*.sh]
indent_size = 2
end_of_line = lf

# YAML, JSON, TOML — 2 spaces is community convention
[*.{yml,yaml,json,toml}]
indent_size = 2

# HTML, CSS, JS for the widget — 2 spaces
[widget/**.{html,css,js}]
indent_size = 2

# Markdown — preserve trailing whitespace (used for line breaks in MD spec)
[*.md]
trim_trailing_whitespace = false

# Makefiles need real tabs
[Makefile]
indent_style = tab
